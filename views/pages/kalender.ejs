<!DOCTYPE html>
<html lang="no">

<head>
  <%- include('../partials/head') -%>
</head>

<body>

  <%- include('../partials/header') -%>

  <main class="calendar-wrap">
    <div class="calendar">
      <!-- Only one iframe is loaded: agenda view on phones, month view otherwise -->
      <iframe id="calendar" title="Kalender for Namsos Athenæum"></iframe>
      <script>
        document.getElementById('calendar').src = matchMedia('(max-width: 767px)').matches
          ? 'https://calendar.google.com/calendar/embed?mode=AGENDA&height=400&wkst=1&src=namsos.athenaeum%40gmail.com&ctz=Europe%2FOslo'
          : 'https://calendar.google.com/calendar/embed?src=namsos.athenaeum%40gmail.com&ctz=Europe%2FOslo';
      </script>
      <noscript>
        <iframe title="Kalender for Namsos Athenæum"
          src="https://calendar.google.com/calendar/embed?src=namsos.athenaeum%40gmail.com&ctz=Europe%2FOslo"></iframe>
      </noscript>
    </div>
  </main>

</body>

</html>
