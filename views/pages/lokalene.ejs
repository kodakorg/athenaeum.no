<!DOCTYPE html>
<html lang="no">

<head>
  <%- include('../partials/head') -%>
</head>

<body>

  <%- include('../partials/header') -%>

  <%
    const rom = [
      { navn: 'Festsalen', bilde: 'festsalen_no_edge', w: 747, h: 443 },
      { navn: 'Salongen', bilde: 'salongen_no_edge', w: 740, h: 468 },
      { navn: 'Peisestuen', bilde: 'peisestuen_no_edge', w: 743, h: 465 },
      { navn: 'Kjøkkenet', bilde: 'kjoekkenet_no_edge', w: 741, h: 564 },
    ];
  %>
  <main class="container narrow pt-3">
    <% rom.forEach(function (r, i) { %>
    <h3><%= r.navn %></h3>
    <picture>
      <source srcset="/images/<%= r.bilde %>.avif" type="image/avif">
      <source srcset="/images/<%= r.bilde %>.webp" type="image/webp">
      <img class="rounded_image" src="/images/<%= r.bilde %>.jpg" width="<%= r.w %>" height="<%= r.h %>"
        alt="<%= r.navn.toLowerCase() %>" <%- i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
    </picture>
    <% }); %>
  </main>

</body>

</html>
