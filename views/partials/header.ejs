<div class="status-bar-tint" aria-hidden="true"></div>
<header class="site-header">
  <a class="header_href" href="/">
    <div class="logo fira-sans-medium">
      <div class="top lined">NAMSOS</div>
      <div class="middle">ATHENÆUM</div>
      <div class="bottom lined">STIFTET 1867</div>
    </div>
  </a>

  <nav class="navbar fira-sans-medium">
    <span class="navbar-brand" id="brand"><%= currentPage ? currentPage.label : '' %></span>
    <button type="button" class="navbar-toggler" aria-controls="navbarCollapse" aria-expanded="false"
      aria-label="Vis meny">
      <span class="icon-container" aria-hidden="true">
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </span>
      <span class="toggler-text">Meny</span>
    </button>
    <div class="navbar-collapse" id="navbarCollapse">
      <div class="navbar-nav">
        <% nav.forEach(function (item) { %>
        <a href="<%= item.href %>" class="nav-link<%= currentPage === item ? ' active' : '' %>"
          <%- currentPage === item ? 'aria-current="page"' : '' %>><%= item.label %></a>
        <% }); %>
      </div>
    </div>
  </nav>
</header>
